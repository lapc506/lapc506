---
import type { ResumeData } from "../lib/resume";
import Section from "./Section.astro";
interface Props {
  data: ResumeData;
}
const { data } = Astro.props;
const { ui, certifications } = data;
const section = ui.sections.certifications;
---

<Section id="certifications" title={section.title} subtitle={section.subtitle}>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      certifications.map((c) => {
        const href = c.website?.url;
        const Card = href ? "a" : "div";
        return (
          <Card
            class="reveal group flex h-full flex-col rounded-lg border border-border bg-card/50 p-5 transition hover:border-primary/50"
            {...(href
              ? { href, target: "_blank", rel: "noopener noreferrer" }
              : {})}
          >
            <div class="mb-3 flex items-start justify-between gap-3">
              <span class="pill shrink-0">{c.date}</span>
              {href && (
                <span
                  aria-hidden="true"
                  class="text-muted-foreground transition group-hover:text-primary"
                >
                  ↗
                </span>
              )}
            </div>
            <h3 class="font-heading text-sm font-semibold leading-snug text-foreground transition group-hover:text-primary">
              {c.title}
            </h3>
            <p class="mt-2 text-sm text-muted-foreground">{c.issuer}</p>
          </Card>
        );
      })
    }
  </div>
</Section>
