---
import type { ResumeData } from "../lib/resume";
import Section from "./Section.astro";
interface Props {
  data: ResumeData;
}
const { data } = Astro.props;
const { ui, projects, portfolio } = data;
const section = ui.sections.ventures;
const ventures = portfolio.ventures;
---

<Section id="ventures" title={section.title} subtitle={section.subtitle}>
  <!-- FEATURED ChimeraNext card -->
  <article
    class="reveal relative overflow-hidden rounded-xl border border-primary/40 bg-card/60 p-6 shadow-xl sm:p-8"
  >
    <!-- gradient accent bar -->
    <div aria-hidden="true" class="absolute inset-x-0 top-0 h-1 bg-brand-gradient"></div>
    <!-- ambient brand glow -->
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -right-24 -top-24 -z-10 h-72 w-72 rounded-full opacity-20 blur-3xl"
      style="background:radial-gradient(closest-side,#7C5CFF,#3B82F6,transparent)"
    >
    </div>

    <div class="flex flex-col gap-6 md:flex-row md:items-start md:justify-between">
      <div class="max-w-2xl">
        <span class="pill mb-3 inline-flex">⛰️ Umbrella stack</span>
        <h3 class="font-heading text-2xl font-bold tracking-tight sm:text-3xl">
          <span class="text-gradient">{ventures.name}</span>
        </h3>
        <p class="mt-3 text-muted-foreground">{ventures.tagline}</p>
      </div>

      <a
        href={ventures.url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex shrink-0 items-center justify-center rounded-md bg-brand-gradient px-5 py-2.5 text-sm font-semibold text-primary-foreground shadow-lg transition hover:opacity-90"
      >
        Visit {ventures.name} →
      </a>
    </div>

    <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        ventures.items.map((v) => (
          <li class="reveal">
            <a
              href={v.url}
              target="_blank"
              rel="noopener noreferrer"
              class="flex h-full flex-col gap-1 rounded-lg border border-border bg-card/50 p-4 transition hover:border-primary/50"
            >
              <span class="font-heading font-semibold text-foreground">{v.name}</span>
              <span class="text-xs text-muted-foreground">{v.sector}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </article>

  <!-- Individual startup project cards -->
  <div class="mt-10 grid gap-4 sm:grid-cols-2">
    {
      projects.map((p) => (
        <article class="reveal flex flex-col rounded-lg border border-border bg-card/50 p-5 transition hover:border-primary/50">
          <div class="mb-2 flex items-baseline justify-between gap-3">
            <h3 class="font-heading font-semibold">{p.name}</h3>
            <span class="shrink-0 font-mono text-xs text-muted-foreground">{p.period}</span>
          </div>
          <div
            set:html={p.description}
            class="space-y-2 text-sm text-muted-foreground [&_ul]:list-disc [&_ul]:space-y-1 [&_ul]:pl-5 [&_li]:marker:text-primary [&_p]:mt-2 [&_em]:text-foreground/90 [&_strong]:text-foreground"
          />
          {p.website?.url && (
            <a
              href={p.website.url}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-4 inline-flex items-center self-start text-sm font-semibold text-primary transition hover:opacity-80"
            >
              {p.website.label || "GitHub"} →
            </a>
          )}
        </article>
      ))
    }
  </div>
</Section>
