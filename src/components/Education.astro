---
import type { ResumeData } from "../lib/resume";
import Section from "./Section.astro";
interface Props {
  data: ResumeData;
}
const { data } = Astro.props;
const { ui, education } = data;
const section = ui.sections.education;
---

<Section id="education" title={section.title} subtitle={section.subtitle}>
  <div class="grid gap-4 sm:grid-cols-2">
    {
      education.map((item) => (
        <article class="reveal rounded-lg border border-border bg-card/50 p-5 transition hover:border-primary/50">
          <div class="flex items-start justify-between gap-3">
            <h3 class="font-heading font-semibold leading-snug">
              {item.website?.url ? (
                <a
                  href={item.website.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="transition hover:text-primary"
                >
                  {item.school}
                </a>
              ) : (
                item.school
              )}
            </h3>
            {item.period && (
              <span class="shrink-0 text-xs text-muted-foreground">{item.period}</span>
            )}
          </div>

          {(item.degree || item.area) && (
            <p class="mt-2 text-sm text-foreground/90">
              {[item.degree, item.area].filter(Boolean).join(" · ")}
            </p>
          )}

          {item.location && (
            <p class="mt-1 text-xs text-muted-foreground">📍 {item.location}</p>
          )}

          {item.description && (
            <div
              set:html={item.description}
              class="mt-3 space-y-2 text-sm text-muted-foreground [&_ul]:list-disc [&_ul]:space-y-1 [&_ul]:pl-5 [&_li]:marker:text-primary [&_p]:mt-2 [&_em]:text-foreground/90 [&_strong]:text-foreground"
            />
          )}
        </article>
      ))
    }
  </div>
</Section>
