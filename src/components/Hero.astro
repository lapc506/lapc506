---
import type { ResumeData } from "../lib/resume";
import IconLink from "./IconLink.astro";
interface Props {
  data: ResumeData;
}
const { data } = Astro.props;
const { ui, basics, portfolio, summary } = data;

const roles = basics.headline.split("|").map((r) => r.trim());
const motto =
  "Leaving a Lasting Legacy is my Driver. Helping others access the opportunities I had is my purpose.";

const stats = [
  { value: "10+", label: ui.hero.stats.years },
  { value: "5", label: ui.hero.stats.companies },
  { value: "5", label: ui.hero.stats.ventures },
];
---

<section
  id="top"
  class="relative scroll-mt-20 overflow-hidden pt-28 pb-16 sm:pt-32 md:pt-36 md:pb-24"
>
  <!-- ambient brand glow -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-24 left-1/2 -z-10 h-[460px] w-[760px] -translate-x-1/2 rounded-full opacity-25 blur-3xl"
    style="background:radial-gradient(closest-side,#7C5CFF,#3B82F6,transparent)"
  >
  </div>

  <div class="mx-auto grid max-w-6xl items-start gap-12 px-5 sm:px-6 md:grid-cols-[1.1fr_0.9fr]">
    <div class="animate-fade-up">
      <!-- profile photo -->
      <div class="mb-6">
        <span class="inline-block rounded-full bg-brand-gradient p-[3px]">
          <img
            src="/profile.jpg"
            alt={basics.name}
            width="112"
            height="112"
            loading="eager"
            class="h-24 w-24 rounded-full border-2 border-background object-cover sm:h-28 sm:w-28"
          />
        </span>
      </div>

      <p class="mb-3 text-sm font-medium text-muted-foreground">{ui.hero.greeting}</p>
      <h1 class="font-heading text-4xl font-extrabold leading-[1.05] tracking-tight sm:text-5xl md:text-6xl">
        <span class="text-gradient">{basics.name}</span>
      </h1>
      <p class="mt-4 flex flex-wrap gap-x-2 gap-y-1 text-lg text-muted-foreground sm:text-xl">
        {
          roles.map((r, i) => (
            <span>
              {i > 0 && <span class="text-primary">{ui.hero.roleSeparator}</span>}
              {r}
            </span>
          ))
        }
      </p>
      <p class="mt-3 text-sm text-muted-foreground">📍 {basics.location}</p>

      <!-- motto (from About) -->
      <blockquote class="mt-6 border-l-2 border-primary/70 pl-4">
        <p class="text-base font-semibold leading-snug sm:text-lg">
          <span class="text-gradient">{motto}</span>
        </p>
      </blockquote>

      <!-- professional summary (from About) -->
      <div
        set:html={summary.content}
        class="mt-5 space-y-3 text-sm leading-relaxed text-muted-foreground [&_p]:mt-3 [&_strong]:text-foreground"
      />

      <div class="mt-7 flex flex-wrap gap-3">
        <a
          href="#ventures"
          class="inline-flex items-center rounded-md bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground transition hover:opacity-90"
        >
          {ui.hero.ctaVentures}
        </a>
      </div>

      <dl class="mt-9 grid max-w-md grid-cols-3 gap-4">
        {
          stats.map((s) => (
            <div class="rounded-lg border border-border bg-card/50 p-4">
              <dd class="font-heading text-2xl font-bold text-foreground">{s.value}</dd>
              <dt class="mt-1 text-xs text-muted-foreground">{s.label}</dt>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="flex flex-col gap-6 md:sticky md:top-24">
      <!-- terminal card -->
      <div class="animate-fade-up rounded-xl border border-border bg-card/70 shadow-xl backdrop-blur">
        <div class="flex items-center gap-2 border-b border-border px-4 py-3">
          <span class="h-3 w-3 rounded-full" style="background:#FB7185"></span>
          <span class="h-3 w-3 rounded-full" style="background:#FBBF24"></span>
          <span class="h-3 w-3 rounded-full" style="background:#34D399"></span>
          <span class="ml-2 font-mono text-xs text-muted-foreground">~/lapc506 — sre.yaml</span>
        </div>
        <pre class="overflow-x-auto p-4 font-mono text-[13px] leading-relaxed"><code><span class="text-muted-foreground"># reliability as code</span>
<span style="color:#22D3EE">apiVersion</span>: lapc506.me/v1
<span style="color:#22D3EE">kind</span>: <span style="color:#EC4899">SiteReliabilityEngineer</span>
<span style="color:#22D3EE">spec</span>:
  <span style="color:#22D3EE">focus</span>: [<span style="color:#34D399">GitOps</span>, <span style="color:#34D399">Observability</span>, <span style="color:#34D399">IaC</span>]
  <span style="color:#22D3EE">clouds</span>: [<span style="color:#34D399">AWS</span>, <span style="color:#34D399">GCP</span>, <span style="color:#34D399">OpenShift</span>]
  <span style="color:#22D3EE">ventures</span>: <span style="color:#7C5CFF">ChimeraNext</span>
  <span style="color:#22D3EE">uptime</span>: <span style="color:#FBBF24">"99.9%"</span></code></pre>
      </div>

      <!-- link hub -->
      <div class="animate-fade-up">
        <p class="mb-3 text-xs font-medium uppercase tracking-wider text-muted-foreground">
          {ui.sections.contact.subtitle}
        </p>
        <div class="flex flex-wrap gap-2.5">
          {portfolio.socialLinks.map((link) => <IconLink link={link} variant="badge" />)}
        </div>
      </div>
    </div>
  </div>
</section>
