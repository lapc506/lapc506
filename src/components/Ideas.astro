---
import type { ResumeData } from "../lib/resume";
import Section from "./Section.astro";
interface Props {
  data: ResumeData;
}
const { data } = Astro.props;
const { ui, portfolio } = data;
const section = ui.sections.ideas;
const ideas = portfolio.ideas;
---

<Section id="ideas" title={section.title} subtitle={section.subtitle}>
  <div class="grid gap-4 sm:grid-cols-2">
    {
      ideas.map((idea) => (
        <article class="reveal flex flex-col rounded-lg border border-dashed border-border bg-card/30 p-5 opacity-90 transition hover:border-primary/50 hover:opacity-100">
          <div class="mb-3 flex items-start justify-between gap-3">
            <h3 class="font-heading font-semibold">{idea.name}</h3>
            <span class="pill shrink-0">{idea.sector}</span>
          </div>
          <span class="mb-3 inline-flex w-fit items-center gap-1.5 rounded-full border border-dashed border-primary/40 bg-primary/5 px-2.5 py-0.5 text-xs font-medium text-muted-foreground">
            <span class="h-1.5 w-1.5 rounded-full bg-brand-gradient" aria-hidden="true" />
            {section.subtitle}
          </span>
          <p class="text-sm text-muted-foreground">{idea.description}</p>
          {idea.url && (
            <a
              href={idea.url}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-4 inline-flex w-fit items-center gap-1 text-sm font-semibold text-primary transition hover:opacity-80"
            >
              {ui.labels.viewRepo}
              <span aria-hidden="true">→</span>
            </a>
          )}
        </article>
      ))
    }
  </div>
</Section>
