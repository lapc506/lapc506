---
import { getResume, type Locale } from "../lib/resume";
import Hero from "./Hero.astro";
import Experience from "./Experience.astro";
import Ventures from "./Ventures.astro";
import Values from "./Values.astro";
import Skills from "./Skills.astro";
import Certifications from "./Certifications.astro";
import Services from "./Services.astro";
import Education from "./Education.astro";
import Communities from "./Communities.astro";
import Languages from "./Languages.astro";
import IdeasInterests from "./IdeasInterests.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const data = getResume(locale);
---

<Hero data={data} />
<Experience data={data} />
<Ventures data={data} />
<Values data={data} />
<Skills data={data} />
<Certifications data={data} />
<Services data={data} />
<Education data={data} />
<Communities data={data} />
<Languages data={data} />
<IdeasInterests data={data} />
