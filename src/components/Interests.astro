---
import type { ResumeData } from "../lib/resume";
import Section from "./Section.astro";
interface Props {
  data: ResumeData;
}
const { data } = Astro.props;
const { ui, interests } = data;
const section = ui.sections.interests;
---

<Section id="interests" title={section.title} subtitle={section.subtitle}>
  <div class="grid gap-4 sm:grid-cols-2">
    {
      interests.map((interest) => (
        <article class="reveal rounded-lg border border-border bg-card/50 p-5 transition hover:border-primary/50">
          <h3 class="font-heading font-semibold">{interest.name}</h3>
          <ul class="mt-3 flex flex-wrap gap-1.5">
            {interest.keywords.map((k) => (
              <li class="pill">{k}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</Section>
