---
import type { ResumeData } from "../lib/resume";
import Section from "./Section.astro";
interface Props {
  data: ResumeData;
}
const { data } = Astro.props;
const { ui, interests, portfolio } = data;
const ideas = portfolio.ideas;
const ideasSection = ui.sections.ideas;
const interestsSection = ui.sections.interests;
const title =
  data.locale === "es" ? "Ideas & Más allá del trabajo" : "Ideas & Beyond Work";
---

<Section id="ideas" title={title}>
  <div class="grid gap-10 md:grid-cols-2">
    <!-- Column 1: Business Ideas (on hiatus) -->
    <div>
      <h3 class="mb-1 text-xs font-semibold uppercase tracking-wider text-muted-foreground">
        {ideasSection.title}
      </h3>
      {ideasSection.subtitle && (
        <p class="mb-4 text-xs text-muted-foreground/80">{ideasSection.subtitle}</p>
      )}
      <div class="space-y-4">
        {
          ideas.map((idea) => (
            <article class="reveal flex flex-col rounded-lg border border-dashed border-border bg-card/30 p-5 opacity-90 transition hover:border-primary/50 hover:opacity-100">
              <div class="mb-2 flex items-start justify-between gap-3">
                <h4 class="font-heading font-semibold">{idea.name}</h4>
                <span class="pill shrink-0">{idea.sector}</span>
              </div>
              <p class="text-sm text-muted-foreground">{idea.description}</p>
              {idea.url && (
                <a
                  href={idea.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-3 inline-flex w-fit items-center gap-1 text-sm font-semibold text-primary transition hover:opacity-80"
                >
                  {ui.labels.viewRepo}
                  <span aria-hidden="true">→</span>
                </a>
              )}
            </article>
          ))
        }
      </div>
    </div>

    <!-- Column 2: Beyond Work (interests) -->
    <div>
      <h3 class="mb-4 text-xs font-semibold uppercase tracking-wider text-muted-foreground">
        {interestsSection.title}
      </h3>
      <div class="space-y-4">
        {
          interests.map((interest) => (
            <article class="reveal rounded-lg border border-border bg-card/50 p-5 transition hover:border-primary/50">
              <h4 class="font-heading font-semibold">{interest.name}</h4>
              <ul class="mt-3 flex flex-wrap gap-1.5">
                {interest.keywords.map((k) => (
                  <li class="pill">{k}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</Section>
