---
import type { ResumeData } from "../lib/resume";
import Section from "./Section.astro";
interface Props {
  data: ResumeData;
}
const { data } = Astro.props;
const { ui, portfolio } = data;
const section = ui.sections.values;
const { items, thinkTanks } = portfolio.values;

// Derive the two group labels from the section title ("Values & Think Tanks").
const [valuesLabel, thinkTanksLabel] = section.title.split("&").map((s) => s.trim());
---

<Section id="values" title={section.title} subtitle={section.subtitle} muted>
  <div class="grid gap-10 md:grid-cols-2">
    <!-- Group 1: Values (non-linked chips) -->
    <div>
      <h3 class="mb-4 text-xs font-semibold uppercase tracking-wider text-muted-foreground">
        {valuesLabel || "Values"}
      </h3>
      <ul class="flex flex-wrap gap-2">
        {
          items.map((v) => (
            <li class="reveal pill">{v.name}</li>
          ))
        }
      </ul>
    </div>

    <!-- Group 2: Think tanks (linked chips) -->
    <div>
      <h3 class="mb-4 text-xs font-semibold uppercase tracking-wider text-muted-foreground">
        {thinkTanksLabel || "Think Tanks"}
      </h3>
      <ul class="flex flex-col gap-2">
        {
          thinkTanks.map((t) => (
            <li class="reveal">
              {t.url ? (
                <a
                  href={t.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex items-center justify-between gap-3 rounded-lg border border-border bg-card/50 px-4 py-2.5 text-sm transition hover:border-primary/50"
                >
                  <span class="font-medium text-foreground">{t.name}</span>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    class="h-4 w-4 shrink-0 text-muted-foreground transition group-hover:text-primary"
                  >
                    <path d="M7 17 17 7" />
                    <path d="M7 7h10v10" />
                  </svg>
                </a>
              ) : (
                <span class="flex items-center rounded-lg border border-border bg-card/50 px-4 py-2.5 text-sm font-medium text-foreground">
                  {t.name}
                </span>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Section>
