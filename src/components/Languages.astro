---
import type { ResumeData } from "../lib/resume";
import Section from "./Section.astro";
interface Props {
  data: ResumeData;
}
const { data } = Astro.props;
const { ui, languages } = data;
const section = ui.sections.languages;
---

<Section id="languages" title={section.title} subtitle={section.subtitle}>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      languages.map((l) => (
        <article class="reveal rounded-lg border border-border bg-card/50 p-5 transition hover:border-primary/50">
          <div class="flex items-center justify-between gap-3">
            <h3 class="font-heading font-semibold">{l.language}</h3>
            <span class="shrink-0 text-sm text-muted-foreground">{l.fluency}</span>
          </div>
          <div class="mt-3 flex gap-1" aria-label={`${l.fluency} (${l.level}/5)`}>
            {Array.from({ length: 5 }).map((_, i) => (
              <span
                class:list={[
                  "h-1.5 w-full rounded-full",
                  i < l.level ? "bg-brand-gradient" : "bg-border",
                ]}
              />
            ))}
          </div>
        </article>
      ))
    }
  </div>
</Section>
