---
import { getResume, type Locale } from "../lib/resume";
import ThemeToggle from "./ThemeToggle.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { ui } = getResume(locale);

const links = [
  { href: "#about", label: ui.nav.about },
  { href: "#experience", label: ui.nav.experience },
  { href: "#ventures", label: ui.nav.ventures },
  { href: "#skills", label: ui.nav.skills },
  { href: "#services", label: ui.nav.services },
  { href: "#education", label: ui.nav.education },
  { href: "#contact", label: ui.nav.contact },
];
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-border/60 bg-background/80 backdrop-blur supports-[backdrop-filter]:bg-background/60"
>
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 sm:px-6">
    <a href="#top" class="font-heading text-lg font-extrabold tracking-tight">
      <span class="text-gradient">APC</span>
    </a>

    <ul class="hidden items-center gap-6 text-sm font-medium text-muted-foreground lg:flex">
      {
        links.map((l) => (
          <li>
            <a href={l.href} class="transition hover:text-foreground">
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2.5">
      <span
        class="hidden items-center gap-1.5 rounded-full border border-success/40 bg-success/10 px-2.5 py-1 text-xs font-medium text-success sm:inline-flex"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-success"></span>
        {ui.nav.openToWork}
      </span>
      <LanguageSwitcher locale={locale} />
      <ThemeToggle label={ui.labels.toggleTheme} />
      <button
        data-mobile-toggle
        type="button"
        aria-label="Menu"
        aria-expanded="false"
        class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-border text-foreground lg:hidden"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
      </button>
    </div>
  </nav>

  <div data-mobile-menu class="hidden border-t border-border/60 bg-background lg:hidden">
    <ul class="space-y-1 px-5 py-4 text-sm font-medium">
      {
        links.map((l) => (
          <li>
            <a href={l.href} class="block rounded-md px-2 py-2 text-muted-foreground hover:bg-muted hover:text-foreground">
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>
