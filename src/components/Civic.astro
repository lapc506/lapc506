---
import type { ResumeData } from "../lib/resume";
import Section from "./Section.astro";
interface Props {
  data: ResumeData;
}
const { data } = Astro.props;
const { ui, portfolio } = data;
const section = ui.sections.civic;
const civicWork = portfolio.civicWork;
---

<Section id="civic" title={section.title} subtitle={section.subtitle}>
  <div class="grid gap-5 sm:grid-cols-2">
    {
      civicWork.map((entry) => (
        <article class="reveal flex flex-col rounded-lg border border-border bg-card/50 p-5 transition hover:border-primary/50">
          <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
            <h3 class="font-heading font-semibold">{entry.organization}</h3>
            <span class="shrink-0 font-mono text-xs text-muted-foreground">
              {entry.period}
            </span>
          </div>
          <p class="mt-1 text-sm font-medium text-primary">{entry.role}</p>

          <ul class="mt-4 space-y-1 text-sm text-muted-foreground">
            {entry.highlights.map((h) => (
              <li class="flex gap-2">
                <span
                  class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-gradient"
                  aria-hidden="true"
                />
                <span>{h}</span>
              </li>
            ))}
          </ul>

          {entry.links.length > 0 && (
            <div class="mt-5 flex flex-wrap gap-2">
              {entry.links.map((link) => (
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center rounded-md border border-border px-3 py-1.5 text-xs font-semibold text-foreground transition hover:border-primary hover:text-primary"
                >
                  {link.label}
                </a>
              ))}
            </div>
          )}
        </article>
      ))
    }
  </div>
</Section>
